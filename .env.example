# ---------------------------------------------------------------------------
# 应用配置（嵌套配置使用双下划线 __ 分隔，例如 APP__DEBUG）
# ---------------------------------------------------------------------------
APP__NAME=opensource-collab-agent
APP__VERSION=0.1.0
APP__ENVIRONMENT=local
APP__DEBUG=true
APP__HOST=127.0.0.1
APP__PORT=8000
APP__API_V1_PREFIX=/api/v1
APP__LOG_LEVEL=INFO
APP__CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP__TRACE_HEADER=X-Trace-Id

# ---------------------------------------------------------------------------
# 数据库：开发期 SQLite，生产期切 PostgreSQL
# 生产可改为：postgresql+asyncpg://user:password@host:5432/agent
# ---------------------------------------------------------------------------
DATABASE__SQLITE_PATH=./data/app.db
DATABASE__ECHO=false
DATABASE__URL_OVERRIDE=

# ---------------------------------------------------------------------------
# 大模型（OpenAI 兼容协议；开源代码模型优先，如 DeepSeek-Coder / CodeQwen）
# 任何兼容 /chat/completions 的服务都可以：vLLM / Ollama / LM Studio / 硅基流动 / 通义
#
# 用法：把本文件复制成 .env，再填入自己的 Key。
#   copy .env.example .env
#
# **这里必须留空**，原因有两个：
#   1. 本文件是要提交/分发的模板，写真实 Key 等于把密钥公开泄露；
#   2. 留占位符（如 sk-replace-me）会让服务误判为"已配置"，
#      前端显示"AI 已就绪"，真正调用时才以 401 失败，学生很难看懂。
# 空值时 /api/v1/tutor/check 等接口返回 503 并提示"请配置 LLM__API_KEY"，
# 这是有意设计的友好降级：项目库与代码分类等功能不受影响，照常可用。
# ---------------------------------------------------------------------------
# ===========================================================================
# 【重点】多模型配置：支持在网页上选模型 + 填自己的 API Key
# ---------------------------------------------------------------------------
# 写一组 LLM__MODELS__<ID>__*，网页的模型下拉框里就会多出一个选项。
#   <ID> 是模型标识，只能用小写字母/数字/下划线/连字符，例如 deepseek、qwen、ollama。
#
# 每个模型可以配这几项（**只有 MODEL_NAME 是必填的**）：
#   LABEL           网页上显示的名字（留空则显示模型名）
#   PROVIDER        提供商标识：deepseek / qwen / openai / ollama / vllm …
#                   写上它就能自动补出 API 地址，不必再填 BASE_URL
#   MODEL_NAME      真正发给服务商的模型名，如 deepseek-chat、qwen-plus
#   BASE_URL        自建/私有网关才需要填（留空按 PROVIDER 自动补）
#   API_KEY         这个模型的默认 Key（留空 = 用网页上输入的，或用全局兜底 Key）
#   API_KEY_ENV     也可以从别的环境变量读 Key，例如 DASHSCOPE_API_KEY
#   DESCRIPTION     给学生的说明文字（显示在网页上）
#   ENABLED         设成 false 可临时隐藏这个模型（不用删配置）
#
# 不想让这套配置生效？把下面每组都注释掉即可，
# 那样就退回"单模型"写法（用本段下面的 LLM__BASE_URL / LLM__MODEL）。
# ===========================================================================

# ---- 模型 1：DeepSeek（官方，性价比高，默认选它）----
LLM__MODELS__DEEPSEEK__LABEL=DeepSeek 官方
LLM__MODELS__DEEPSEEK__PROVIDER=deepseek
LLM__MODELS__DEEPSEEK__MODEL_NAME=deepseek-chat
LLM__MODELS__DEEPSEEK__DESCRIPTION=在 platform.deepseek.com 申请 Key，注册一般送额度
LLM__MODELS__DEEPSEEK__API_KEY=
# LLM__MODELS__DEEPSEEK__BASE_URL=https://api.deepseek.com/v1

# ---- 模型 2：通义千问 Qwen（阿里云百炼，OpenAI 兼容模式）----
LLM__MODELS__QWEN__LABEL=通义千问 Qwen
LLM__MODELS__QWEN__PROVIDER=qwen
LLM__MODELS__QWEN__MODEL_NAME=qwen-plus
LLM__MODELS__QWEN__DESCRIPTION=在 bailian.console.aliyun.com 申请 DashScope Key
LLM__MODELS__QWEN__API_KEY=
# 也可以让 Key 从别的环境变量读，避免同一条密钥写两处：
# LLM__MODELS__QWEN__API_KEY_ENV=DASHSCOPE_API_KEY
# LLM__MODELS__QWEN__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 模型 3：Ollama（本地跑，不需要 Key，断网也能演示）----
# 用法：先装 Ollama 并执行 `ollama pull qwen2.5-coder:7b`，保持 ollama serve 在跑。
LLM__MODELS__OLLAMA__LABEL=本地 Ollama（免 Key）
LLM__MODELS__OLLAMA__PROVIDER=ollama
LLM__MODELS__OLLAMA__MODEL_NAME=qwen2.5-coder:7b
LLM__MODELS__OLLAMA__DESCRIPTION=本地模型，不需要 API Key；需先 ollama pull 对应模型
# LLM__MODELS__OLLAMA__BASE_URL=http://127.0.0.1:11434/v1

# 默认用哪个模型（填上面的 <ID>）。留空 = 用第一个。
LLM__DEFAULT_MODEL=deepseek

# ---------------------------------------------------------------------------
# 单模型写法（旧配置，仍然完全兼容），有两个用途：
#   1. 一套多模型都没配时，这里就是唯一模型；
#   2. 配了多模型时，这里是"全局默认值"：多模型没写的超时 / max_tokens 从这里继承，
#      而 LLM__API_KEY 还兼任**兜底 Key**：某个云端模型没单独配 Key 时用它。
#      （本地模型不吃兜底 Key，免得把云端密钥发给本机服务）
# ---------------------------------------------------------------------------
LLM__PROVIDER=openai-compatible
# DeepSeek 官方端点；本地推理改成 http://127.0.0.1:8000/v1 之类
LLM__BASE_URL=https://api.deepseek.com/v1
LLM__API_KEY=
# 实测说明：DeepSeek 会把模型名统一路由到当前可用的主力模型
# （请求 deepseek-coder / deepseek-chat 都返回 model=deepseek-flash），
# 所以这里填任何一个 DeepSeek 官方模型名都能用；换别的服务商时按它的文档填。
LLM__MODEL=deepseek-chat
LLM__TIMEOUT_SECONDS=120
LLM__MAX_TOKENS=4096
LLM__TEMPERATURE=0.2
LLM__MAX_RETRIES=2
LLM__RETRY_BACKOFF_SECONDS=1.0

# ---------------------------------------------------------------------------
# 安全：网页上填的 API Key 怎么临时保管
#
# 背景：支持同学在网页上选模型、填自己的 Key。那些 Key 只放在**服务端内存**里，
# 不写数据库、不进日志，进程重启就没了（详见 app/core/api_key_manager.py）。
# 下面三项控制这份内存保管箱的行为。
# ---------------------------------------------------------------------------
# 多久没用就自动清除（秒）。默认 1800 = 30 分钟；每次使用都会顺延
SECURITY__API_KEY_TTL_SECONDS=1800
# 内存里最多同时保留多少个会话。set_key 是无需登录就能调的接口，
# 不设上限的话有人循环调用就能把内存吃满；超出后淘汰最久没用的会话
SECURITY__MAX_SESSIONS=500
# 是否允许前端传 Key。设成 false = 只能用上面 .env 里配好的 Key，
# 网页上的「填 Key」会被 403 拒绝（适合"统一由老师配 Key"的课堂场景）
SECURITY__ALLOW_CLIENT_KEY=true

# ---------------------------------------------------------------------------
# 检索：BM25 + 向量库混合召回 + RRF 融合（Step 3）
# ---------------------------------------------------------------------------
RETRIEVAL__VECTOR_BACKEND=faiss
RETRIEVAL__INDEX_DIR=./data/index
# 嵌入后端：fastembed=真语义(ONNX)；hashing=零依赖确定性哈希（离线/CI 兜底）
RETRIEVAL__EMBEDDER=fastembed
RETRIEVAL__EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RETRIEVAL__EMBEDDING_DIM=512
RETRIEVAL__MODEL_CACHE_DIR=./data/models
# 公网 huggingface.co 不可达时走镜像；Xet 协议镜像不代理，必须关闭
RETRIEVAL__HF_ENDPOINT=https://hf-mirror.com
RETRIEVAL__HF_DISABLE_XET=true
RETRIEVAL__TOP_K=10
RETRIEVAL__CANDIDATE_MULTIPLIER=3
RETRIEVAL__BM25_WEIGHT=0.5
RETRIEVAL__VECTOR_WEIGHT=0.5
RETRIEVAL__RRF_K=60
RETRIEVAL__MAX_CHUNK_CHARS=2000

# ---------------------------------------------------------------------------
# Docker 沙箱：隔离执行 pytest / coverage（Step 5）
# backend: auto=优先 docker，不可用则降级 local；docker/local=强制指定
# 注意：local 后端**不具备隔离能力**，仅用于开发/CI
# ---------------------------------------------------------------------------
DOCKER__BACKEND=auto
DOCKER__IMAGE=python:3.10-slim
DOCKER__BASE_IMAGE=python:3.10-slim
# 纯净镜像不含 pytest/coverage，需启动时 pip 安装（这一步需要网络）
# 生产建议：用 docker/sandbox.Dockerfile 预构建镜像，然后置为 false 并开启断网
DOCKER__INSTALL_DEPENDENCIES=true
DOCKER__PIP_INDEX_URL=
# 生产建议设为非 root，如 1000:1000（需预先 chown 工作目录）
DOCKER__SANDBOX_USER=
DOCKER__TIMEOUT_SECONDS=300
DOCKER__MEMORY_LIMIT=1g
DOCKER__CPU_LIMIT=2.0
DOCKER__PIDS_LIMIT=256
DOCKER__NETWORK_DISABLED=true
DOCKER__READ_ONLY_ROOT=true
DOCKER__TMPFS_SIZE=64m
DOCKER__WORKSPACE_DIR=./data/workspaces
DOCKER__WORKSPACE_MOUNT=/workspace
DOCKER__MAX_OUTPUT_BYTES=1000000
DOCKER__TEST_DIR=tests

# ---------------------------------------------------------------------------
# Agent Trace
# ---------------------------------------------------------------------------
TRACING__ENABLED=true
TRACING__SINK=log
TRACING__CAPTURE_INPUT=true
TRACING__CAPTURE_OUTPUT=true
TRACING__MAX_PAYLOAD_CHARS=2000
TRACING__MEMORY_BUFFER_SIZE=1000

# ---------------------------------------------------------------------------
# 仓库解析（Step 2）：克隆策略与安全边界
# 注意：列表型配置用逗号分隔即可，也兼容 ["a","b"] JSON 写法
# ---------------------------------------------------------------------------
REPOSITORY__WORKSPACE_DIR=./data/repos
# 浅克隆深度；设为 0 表示完整克隆（需要 git 历史时用）
REPOSITORY__CLONE_DEPTH=1
REPOSITORY__CLONE_TIMEOUT_SECONDS=300
# 白名单主机：只允许从这些主机克隆，挡掉 file:// 与 SSRF
REPOSITORY__ALLOWED_HOSTS=github.com,gitee.com
REPOSITORY__MAX_REPO_SIZE_MB=500
REPOSITORY__MAX_FILES=5000
REPOSITORY__MAX_FILE_BYTES=512000
REPOSITORY__EXCLUDED_DIRS=.git,node_modules,__pycache__,.venv,venv,dist,build,target,vendor

# ---------------------------------------------------------------------------
# 本地项目库（面向学生的代码导师场景）：扫描本地文件夹并按语言自动分类
#
# 留空表示只扫描 data/library 目录，并附带项目自带的 examples 示例目录，
# 这样第一次打开页面就有东西可以点。
#
# 想扫描自己放作业的文件夹（多个目录用逗号分隔，"或"写成 JSON 数组也可以）：
#   LIBRARY__ROOTS=D:\我的作业, E:\课程代码
#
# 安全说明：能被扫描的目录**只能在这里配置**，页面/接口无法指定任意路径，
# 读取与写入时都会校验目标文件确实落在根目录内，`../` 与指向外部的软链接都会被拒绝。
# 写入类操作（编辑保存 / 替换 / 删除）另外还有三道保险：
#   1) 只能改已存在的源码文件，新建文件必须走「拖进项目库」的入库流程；
#   2) 删除默认移进 <ROOT>/.trash（带时间戳），学生手滑还能自己找回；
#   3) 保存时前端会带上打开文件时拿到的 sha256，对不上就拒绝覆盖（防并发改乱）。
# ---------------------------------------------------------------------------
LIBRARY__ROOTS=
# 目录递归深度上限（防止层级过深或软链接成环把扫描拖死）
LIBRARY__MAX_DEPTH=6
# 单次扫描最多收录多少个代码文件
LIBRARY__MAX_FILES=500
# 单文件超过这个大小就只登记元信息、不读内容（默认 500KB）
LIBRARY__MAX_FILE_BYTES=512000
# 是否附带项目自带的 examples 示例目录（仅在未配置 LIBRARY__ROOTS 时生效）
LIBRARY__INCLUDE_EXAMPLES=true

# ---- 写入类操作（在线编辑保存 / 替换 / 删除）----
# 是否允许在页面上改文件。
#   true （默认）：页面上可以编辑保存、用本机文件替换、删除文件；
#   false        ：整体只读，这三个入口会从界面上消失（适合指向老师共享的公共目录）。
# 想改成只读，把下面这行前面的 # 去掉并设为 false 即可。
# LIBRARY__ALLOW_WRITE=true
# 删除文件时先移到哪（相对每个项目库根目录）；设成空字符串 = 直接彻底删除、不留回收站。
# 这个目录会被自动排除在扫描之外，所以删掉的文件不会又出现在列表里。
# LIBRARY__TRASH_DIR_NAME=.trash

# ---------------------------------------------------------------------------
# 本地代码文件自动分类（注意：这个功能**会真的移动文件**）
#
# 与上面的「本地项目库」的区别：
#   项目库（LIBRARY__*）默认只浏览：原地扫描、只登记；
#     只有你主动点「编辑 → 保存」「替换」「删除」才会改文件，
#     其中删除是移到 .trash 回收站，写操作也可以整体关掉（LIBRARY__ALLOW_WRITE=false）；
#   分类器（CLASSIFIER__*）会按扩展名把文件搬进子目录：
#     .c / .h  -> <ROOT>/c/
#     .java    -> <ROOT>/java/
#     .py      -> <ROOT>/python/
#     其它     -> 默认留在原地只做登记；MOVE_UNKNOWN=true 才搬到 <ROOT>/unknown/
#
# 安全设计：可扫描的目录**只能在这里配置**，接口里没有参数能指向任意路径
# （只能传根目录的子目录名），因此不会误扫系统目录；
# 移动时也不会覆盖同名文件，重名会自动加 _1、_2 后缀。
# ---------------------------------------------------------------------------
# 待分类的根目录：学生把散放的代码丢进来，扫描后自动归类
CLASSIFIER__ROOT=data/library
# 是否递归子目录
CLASSIFIER__RECURSIVE=true
# 未知类型的文件是否也搬到 unknown/（默认否：只登记、不移动，避免误搬重要资料）
CLASSIFIER__MOVE_UNKNOWN=false
# 单次扫描最多处理多少个文件
CLASSIFIER__MAX_FILES=2000
# 单文件大小上限（字节），超过只登记不移动
CLASSIFIER__MAX_FILE_BYTES=5242880
# 遍历时跳过的目录名（逗号分隔）
CLASSIFIER__EXCLUDED_DIRS=.git,node_modules,__pycache__,.venv,venv,dist,build,target,site-packages

